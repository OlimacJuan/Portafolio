---
// Un post-it con la imagen principal del proyecto, pegado con cinta sobre el plano.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { url } from '../config';

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
  indice?: number;
}
const { proyecto, indice = 0 } = Astro.props;
const d = proyecto.data;
// Inclinación determinista, distinta para cada post-it
const giros = [-2.2, 1.6, -0.8, 2.4, -1.6, 0.9];
const giro = giros[indice % giros.length];
const anio = d.fecha.getFullYear();
---

<a
  href={url(`/proyectos/${proyecto.id}/`)}
  class:list={['postit', `postit-${d.postit}`]}
  style={`--giro:${giro}deg`}
  data-area={d.area}
>
  <span class="cinta" aria-hidden="true"></span>
  <span class="foto">
    <Image src={d.imagen} alt={d.imagenAlt} width={640} widths={[320, 640]} sizes="(min-width: 720px) 300px, 80vw" />
  </span>
  <span class="titulo">{d.titulo}</span>
  <span class="meta">{d.area} · {anio}</span>
  {d.ejemplo && <span class="ejemplo">Ejemplo, reemplazar</span>}
</a>

<style>
  .postit {
    --fondo: var(--postit-amarillo);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.9rem 0.9rem 1.1rem;
    background: var(--fondo);
    color: var(--color-texto);
    text-decoration: none;
    transform: rotate(var(--giro));
    box-shadow:
      0 1px 1px rgb(0 0 0 / 0.12),
      0 10px 22px -8px rgb(0 0 0 / 0.45);
    transition:
      transform 260ms var(--ease-out-fuerte),
      box-shadow 260ms var(--ease-out-fuerte);
  }
  .postit:visited {
    color: var(--color-texto);
  }
  .postit-cian {
    --fondo: var(--postit-cian);
  }
  .postit-verde {
    --fondo: var(--postit-verde);
  }
  .postit-blanco {
    --fondo: var(--postit-blanco);
  }
  /* Esquina inferior levemente despegada */
  .postit::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    width: 2.2rem;
    height: 2.2rem;
    background: linear-gradient(135deg, transparent 50%, rgb(0 0 0 / 0.08) 50%);
    pointer-events: none;
  }
  .cinta {
    position: absolute;
    top: -0.7rem;
    left: 50%;
    width: 5.5rem;
    height: 1.5rem;
    transform: translateX(-50%) rotate(calc(var(--giro) * -1.5));
    background: rgb(255 255 255 / 0.55);
    border-left: 1px dashed rgb(0 0 0 / 0.08);
    border-right: 1px dashed rgb(0 0 0 / 0.08);
    backdrop-filter: blur(1px);
  }
  .foto {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: rgb(255 255 255 / 0.6);
    outline: 1px solid rgb(0 0 0 / 0.08);
  }
  .foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .titulo {
    font-family: var(--font-mano);
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.05;
    margin-top: 0.4rem;
  }
  .meta {
    font-size: 0.8rem;
    color: var(--color-texto-2);
  }
  .ejemplo {
    align-self: flex-start;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--color-texto-2);
    color: var(--color-texto-2);
    border-radius: 999px;
  }
  .postit:active {
    transform: rotate(0deg) scale(0.98);
  }
  @media (hover: hover) and (pointer: fine) {
    .postit:hover {
      transform: rotate(0deg) translateY(-6px);
      box-shadow:
        0 2px 2px rgb(0 0 0 / 0.1),
        0 22px 36px -12px rgb(0 0 0 / 0.55);
    }
  }
</style>
