---
import 'katex/dist/katex.min.css';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CalculadoraViga from '../../components/CalculadoraViga.astro';
import ModeloCAD from '../../components/ModeloCAD.astro';
import { url } from '../../config';

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos');
  return proyectos.map((p) => ({ params: { slug: p.id }, props: { proyecto: p } }));
}

const { proyecto } = Astro.props;
const d = proyecto.data;
const { Content } = await render(proyecto);
const fecha = d.fecha.toLocaleDateString('es-CO', { year: 'numeric', month: 'long', timeZone: 'UTC' });
---

<Base titulo={d.titulo} descripcion={d.resumen}>
  <article>
    <header class="cabeza blueprint">
      <div class="interior cabeza-grid">
        <div>
          <a class="volver" href={url('/proyectos/')}>← Todos los proyectos</a>
          <h1>{d.titulo}</h1>
          <p class="resumen">{d.resumen}</p>
          {d.ejemplo && <p class="aviso-ejemplo">Proyecto de ejemplo para mostrar el formato. Reemplázalo por uno tuyo.</p>}
        </div>
        <figure class="portada">
          <Image src={d.imagen} alt={d.imagenAlt} width={900} widths={[480, 900]} sizes="(min-width: 900px) 34rem, 100vw" loading="eager" />
        </figure>
      </div>
    </header>

    <div class="interior cuerpo">
      <aside class="ficha" aria-label="Ficha del proyecto">
        <dl>
          <div><dt>Área</dt><dd>{d.area}</dd></div>
          <div><dt>Fecha</dt><dd>{fecha}</dd></div>
          <div><dt>Contexto</dt><dd>{d.contexto}</dd></div>
          <div><dt>Mi rol</dt><dd>{d.miRol}</dd></div>
          {
            d.equipo.length > 0 && (
              <div>
                <dt>Equipo</dt>
                <dd>
                  <ul>
                    {d.equipo.map((m) => (
                      <li>
                        {m.nombre}, <span class="rol">{m.rol}</span>
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            )
          }
          <div><dt>Licencia</dt><dd>{d.licencia}</dd></div>
        </dl>
      </aside>

      <div class="prosa">
        <Content components={{ CalculadoraViga, ModeloCAD }} />
        <p class="descargo">
          Trabajo académico. Los cálculos y resultados se presentan con fines formativos y no constituyen un diseño validado
          para fabricación o uso.
        </p>
      </div>
    </div>
  </article>
</Base>

<style>
  .interior {
    max-width: 76rem;
    margin: 0 auto;
    padding-left: 1rem;
    padding-right: 1rem;
  }
  .cabeza-grid {
    display: grid;
    gap: 2.5rem;
    padding-top: calc(2.5rem + var(--alto-cabecera));
    padding-bottom: 3rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .cabeza-grid {
      grid-template-columns: 1fr 34rem;
    }
  }
  .volver,
  .volver:visited {
    font-size: 0.9rem;
    color: color-mix(in oklab, white 80%, var(--color-cian));
    text-decoration: none;
  }
  .volver:hover {
    text-decoration: underline;
  }
  h1 {
    margin-top: 1rem;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .resumen {
    margin-top: 1rem;
    font-size: 1.2rem;
    line-height: 1.55;
    max-width: 48ch;
    color: color-mix(in oklab, white 85%, var(--color-cian));
  }
  .aviso-ejemplo {
    display: inline-block;
    margin-top: 1.25rem;
    font-size: 0.9rem;
    padding: 0.35rem 0.7rem;
    border-radius: 6px;
    background: var(--postit-amarillo);
    color: var(--color-texto);
  }
  .portada {
    background: var(--postit-blanco);
    padding: 0.75rem 0.75rem 0.75rem;
    transform: rotate(1deg);
    box-shadow: 0 14px 30px -12px rgb(0 0 0 / 0.6);
  }
  .portada :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .cuerpo {
    display: grid;
    gap: 2.5rem;
    padding-top: 3rem;
    padding-bottom: 5rem;
  }
  @media (min-width: 1000px) {
    .cuerpo {
      grid-template-columns: 16rem minmax(0, 1fr);
      gap: 4rem;
    }
    .ficha {
      position: sticky;
      top: 6rem;
      align-self: start;
    }
  }
  .ficha dl {
    display: grid;
    gap: 1rem;
    font-size: 0.92rem;
    line-height: 1.45;
    border-top: 3px solid var(--color-marino);
    padding-top: 1rem;
  }
  .ficha dt {
    color: var(--color-texto-2);
    font-size: 0.8rem;
  }
  .ficha dd {
    margin-top: 0.15rem;
  }
  .rol {
    color: var(--color-texto-2);
  }
  .descargo {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-fondo-2);
    font-size: 0.88rem;
    color: var(--color-texto-2);
  }
</style>
