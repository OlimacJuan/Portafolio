---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../config';

const metodos = (await getCollection('metodologias')).sort((a, b) => a.data.orden - b.data.orden);
---

<Base titulo="Metodologías de diseño" descripcion="Metodologías de diseño en ingeniería mecánica y cómo las aplico en mis proyectos.">
  <div class="interior">
    <header>
      <h1>Metodologías de diseño</h1>
      <p>Los métodos que uso para pasar de una necesidad a una solución, cada uno con su diagrama y el proyecto donde lo apliqué.</p>
    </header>
    <ol class="lista">
      {
        metodos.map((m) => (
          <li class:list={{ borrador: m.data.borrador }}>
            {m.data.borrador ? (
              <div class="fila">
                <span class="nombre">{m.data.titulo}</span>
                <span class="texto">{m.data.resumen}</span>
                <span class="estado">En preparación</span>
              </div>
            ) : (
              <a class="fila" href={url(`/metodologias/${m.id}/`)}>
                <span class="nombre">{m.data.titulo}</span>
                <span class="texto">{m.data.resumen}</span>
                <span class="estado">Leer</span>
              </a>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</Base>

<style>
  .interior {
    max-width: 76rem;
    margin: 0 auto;
    padding: 3rem 1rem 5rem;
  }
  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    max-width: 14ch;
  }
  header p {
    margin-top: 1rem;
    max-width: 56ch;
    line-height: 1.55;
    color: var(--color-texto-2);
  }
  .lista {
    margin-top: 3rem;
    border-top: 3px solid var(--color-marino);
  }
  .lista li {
    border-bottom: 1px solid var(--color-fondo-2);
  }
  .fila {
    display: grid;
    gap: 0.35rem 2rem;
    padding: 1.4rem 0;
    color: var(--color-texto);
    text-decoration: none;
  }
  @media (min-width: 800px) {
    .fila {
      grid-template-columns: 18rem 1fr 8rem;
      align-items: baseline;
    }
  }
  .nombre {
    font-size: 1.25rem;
    font-weight: 650;
  }
  .texto {
    color: var(--color-texto-2);
    line-height: 1.55;
  }
  .estado {
    font-size: 0.85rem;
    color: var(--color-texto-2);
  }
  a.fila .estado {
    color: var(--color-vinculo);
    font-weight: 600;
  }
  .borrador .nombre {
    color: var(--color-texto-2);
  }
  @media (hover: hover) and (pointer: fine) {
    a.fila:hover .nombre {
      text-decoration: underline;
      text-decoration-color: var(--color-amarillo);
      text-decoration-thickness: 3px;
      text-underline-offset: 0.25em;
    }
  }
</style>
