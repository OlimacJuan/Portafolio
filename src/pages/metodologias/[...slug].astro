---
// Dirección antigua: redirige al libro en la sección Conocimiento.
import { getCollection } from 'astro:content';
import Redirigir from '../../components/Redirigir.astro';
export async function getStaticPaths() {
  return (await getCollection('metodologias')).filter((e) => !e.data.borrador).map((e) => ({ params: { slug: e.id } }));
}
const { slug } = Astro.params;
---
<Redirigir a={`/conocimiento/metodologias/${slug}/`} />
