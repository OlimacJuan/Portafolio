---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostIt from '../components/PostIt.astro';
import PostItVacio from '../components/PostItVacio.astro';
import { sitio, url } from '../config';

const proyectos = (await getCollection('proyectos')).sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());
const destacados = [...proyectos.filter((p) => p.data.destacado), ...proyectos.filter((p) => !p.data.destacado)].slice(0, 3);
const vacios = Math.max(0, 3 - destacados.length);

---

<Base plano>
  <section class="hero">
    <div class="hero-interior">
      <div class="hero-texto">
        <h1>{sitio.nombre}</h1>
        <p class="lema">
          {sitio.titulo}{sitio.universidad && `, ${sitio.universidad}`}. Diseño, análisis y fabricación de sistemas
          mecánicos, explicados paso a paso.
        </p>
        <div class="acciones">
          <a class="boton boton-primario" href={url('/proyectos/')}>Ver proyectos</a>
          <a class="boton boton-secundario" href={url('/conocimiento/')}>Explorar conocimiento</a>
        </div>
      </div>

      <svg class="plano" viewBox="0 0 520 300" role="img" aria-label="Dibujo técnico de un eje escalonado con sus cotas">
        <g class="trazo" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">
          <path pathLength="1" d="M40 125h70v-25h170v-15h90v15h70v25h40v50h-40v25h-70v15h-90v-15H110v-25H40z" />
          <path pathLength="1" d="M110 100v100M280 85v130M370 85v130M440 125v50" stroke-width="1" />
          <path pathLength="1" d="M300 85h50v-8h-50z" stroke-width="1" />
        </g>
        <g class="cota" fill="none" stroke-width="1">
          <path pathLength="1" class="eje" d="M20 150h460" />
          <path pathLength="1" d="M40 235v28M110 220v43M280 220v43M370 230v33M440 205v58M480 185v78" />
          <path pathLength="1" d="M40 255h70M110 255h170M280 255h90M370 255h70M440 255h40" />
          <path pathLength="1" d="M60 100v-40M60 200v40" />
        </g>
        <g class="rotulos" fill="currentColor" font-size="12" text-anchor="middle">
          <text x="75" y="248">30</text>
          <text x="195" y="248">85</text>
          <text x="325" y="248">45</text>
          <text x="405" y="248">35</text>
          <text x="460" y="248">20</text>
          <text x="196" y="72">Ø40 h6</text>
          <text x="325" y="72">chavetero</text>
        </g>
      </svg>
    </div>
  </section>

  <section class="destacados" aria-label="Proyectos y conocimiento">
    <div class="interior">
      <h2 id="t-destacados">Proyectos recientes</h2>
      <div class="tablero">
        {destacados.map((p, i) => <PostIt proyecto={p} indice={i} />)}
        {Array.from({ length: vacios }, (_, i) => <PostItVacio indice={i} />)}
      </div>
      <a class="ver-todos" href={url('/proyectos/')}>Ver todos los proyectos</a>

      <h2 class="visually-hidden">Conocimiento</h2>
      <div class="mesa">
        <a class="portada" href={url('/conocimiento/')} aria-label="Conocimiento: metodologías de diseño y fundamentos teóricos">
          <span class="lomo-borde" aria-hidden="true"></span>
          <span class="tapa">
            <svg class="cover-dibujo" viewBox="0 0 120 120" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4">
              <circle cx="60" cy="60" r="44" />
              <circle cx="60" cy="60" r="26" />
              <circle cx="60" cy="60" r="5" />
              <path d="M8 60h104M60 8v104" stroke-width="0.8" stroke-dasharray="6 3 1.5 3" />
              <path d="M60 60l31-31" />
            </svg>
            <span class="cover-titulo">Conocimiento</span>
            <span class="cover-sub">Metodologías de diseño<br />y fundamentos teóricos</span>
          </span>
          <span class="paginas" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </section>


</Base>

<style>
  .hero-interior {
    max-width: 76rem;
    margin: 0 auto;
    padding: calc(clamp(3rem, 8vw, 6.5rem) + var(--alto-cabecera)) 1rem clamp(3rem, 7vw, 5.5rem);
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero-interior {
      grid-template-columns: 1.05fr 1fr;
    }
  }
  h1 {
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  .lema {
    margin-top: 1.25rem;
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    line-height: 1.55;
    max-width: 38ch;
    color: color-mix(in oklab, white 82%, var(--color-cian));
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .boton {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.15rem;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 160ms var(--ease-out-fuerte),
      background-color 160ms ease;
  }
  .boton:active {
    transform: scale(0.97);
  }
  .boton-primario,
  .boton-primario:visited {
    background: var(--color-amarillo);
    color: var(--color-texto);
  }
  .boton-primario:hover {
    background: color-mix(in oklab, var(--color-amarillo) 85%, white);
  }
  .boton-secundario,
  .boton-secundario:visited {
    color: #fff;
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-cian) 70%, white);
  }
  .boton-secundario:hover {
    background: rgb(255 255 255 / 0.06);
  }

  /* Dibujo técnico que se traza una sola vez al cargar */
  .plano {
    width: 100%;
    max-width: 560px;
    justify-self: center;
    color: color-mix(in oklab, white 88%, var(--color-cian));
  }
  .plano path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: trazar 1.6s var(--ease-out-fuerte) forwards;
  }
  .cota {
    stroke: var(--color-cian);
  }
  .cota path {
    animation-delay: 0.7s;
  }
  .cota .eje {
    stroke-dasharray: 0.03 0.012 0.004 0.012;
    stroke-dashoffset: 0;
    animation: aparecer 0.6s ease 0.5s both;
  }
  .rotulos {
    fill: var(--color-cian);
    font-family: var(--font-mono);
    animation: aparecer 0.6s ease 1.4s both;
  }
  @keyframes trazar {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes aparecer {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .plano path {
      stroke-dashoffset: 0;
      animation: none;
    }
    .cota .eje {
      stroke-dasharray: 0.03 0.012 0.004 0.012;
    }
  }

  .interior {
    max-width: 76rem;
    margin: 0 auto;
    padding: 3.5rem 1rem 4.5rem;
  }
  .destacados h2 {
    font-size: 1.5rem;
    font-weight: 650;
  }
  .tablero {
    margin-top: 2.5rem;
    display: grid;
    gap: 2.75rem 2.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }

  .ver-todos,
  .ver-todos:visited {
    display: block;
    width: fit-content;
    margin: 3rem auto 0;
    color: #fff;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-amarillo);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  /* Libro "Conocimiento" de pie sobre el plano */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  /* Libro "Conocimiento": portada vista de frente sobre el plano */
  .mesa {
    display: grid;
    place-items: center;
    margin-top: 4.5rem;
    padding-bottom: 0.5rem;
  }
  .portada {
    --ancho: min(19rem, 78vw);
    position: relative;
    display: block;
    width: var(--ancho);
    aspect-ratio: 3 / 4;
    color: var(--color-texto);
    text-decoration: none;
    transform: rotate(-1.4deg);
    transition: transform 280ms var(--ease-out-fuerte);
    filter: drop-shadow(0 26px 22px rgb(0 0 0 / 0.55)) drop-shadow(0 4px 4px rgb(0 0 0 / 0.35));
  }
  .portada:visited {
    color: var(--color-texto);
  }
  .tapa {
    position: absolute;
    inset: 0 0.55rem 0 0.9rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2.1rem 1.5rem 1.8rem;
    background: var(--color-amarillo);
    border-radius: 2px 6px 6px 2px;
    box-shadow:
      inset 0 0 0 1px rgb(0 0 0 / 0.1),
      inset 8px 0 14px -8px rgb(0 0 0 / 0.35);
  }
  /* Marco fino impreso en la portada */
  .tapa::before {
    content: '';
    position: absolute;
    inset: 0.8rem 0.8rem 0.8rem 1.1rem;
    border: 1.5px solid var(--color-marino);
    border-radius: 1px;
    pointer-events: none;
  }
  .lomo-borde {
    position: absolute;
    inset: 0 auto 0 0;
    width: 1.4rem;
    background: color-mix(in oklab, var(--color-amarillo) 78%, black);
    border-radius: 4px 0 0 4px;
    box-shadow: inset -3px 0 0 rgb(0 0 0 / 0.18), inset 2px 0 0 rgb(255 255 255 / 0.25);
  }
  .paginas {
    position: absolute;
    inset: 0.35rem 0 0.35rem auto;
    width: 0.9rem;
    background: repeating-linear-gradient(180deg, #fbfbf8 0 2px, #dcdbd6 2px 3px);
    border-radius: 0 3px 3px 0;
    z-index: -1;
  }
  .cover-dibujo {
    width: 7.5rem;
    margin-top: 0.8rem;
    color: var(--color-marino);
  }
  .cover-titulo {
    margin-top: 1.6rem;
    font-size: clamp(1.9rem, 5vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-marino);
  }
  .cover-sub {
    margin-top: auto;
    padding-bottom: 0.4rem;
    text-align: center;
    font-size: 0.88rem;
    line-height: 1.4;
    color: var(--color-marino);
  }
  .portada:active {
    transform: rotate(0deg) scale(0.98);
  }
  @media (hover: hover) and (pointer: fine) {
    .portada:hover {
      transform: rotate(0deg) translateY(-8px);
    }
  }
</style>
