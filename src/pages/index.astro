---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostIt from '../components/PostIt.astro';
import PostItVacio from '../components/PostItVacio.astro';
import { sitio, url } from '../config';

const proyectos = (await getCollection('proyectos')).sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());
const destacados = [...proyectos.filter((p) => p.data.destacado), ...proyectos.filter((p) => !p.data.destacado)].slice(0, 3);
const vacios = Math.max(0, 3 - destacados.length);

---

<Base>
  <section class="hero blueprint">
    <div class="hero-interior">
      <div class="hero-texto">
        <h1>{sitio.nombre}</h1>
        <p class="lema">
          {sitio.titulo}{sitio.universidad && `, ${sitio.universidad}`}. Diseño, análisis y fabricación de sistemas
          mecánicos, explicados paso a paso.
        </p>
        <div class="acciones">
          <a class="boton boton-primario" href={url('/proyectos/')}>Ver proyectos</a>
          <a class="boton boton-secundario" href={url('/conocimiento/')}>Explorar conocimiento</a>
        </div>
      </div>

      <svg class="plano" viewBox="0 0 520 300" role="img" aria-label="Dibujo técnico de un eje escalonado con sus cotas">
        <g class="trazo" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">
          <path pathLength="1" d="M40 125h70v-25h170v-15h90v15h70v25h40v50h-40v25h-70v15h-90v-15H110v-25H40z" />
          <path pathLength="1" d="M110 100v100M280 85v130M370 85v130M440 125v50" stroke-width="1" />
          <path pathLength="1" d="M300 85h50v-8h-50z" stroke-width="1" />
        </g>
        <g class="cota" fill="none" stroke-width="1">
          <path pathLength="1" class="eje" d="M20 150h460" />
          <path pathLength="1" d="M40 235v28M110 220v43M280 220v43M370 230v33M440 205v58M480 185v78" />
          <path pathLength="1" d="M40 255h70M110 255h170M280 255h90M370 255h70M440 255h40" />
          <path pathLength="1" d="M60 100v-40M60 200v40" />
        </g>
        <g class="rotulos" fill="currentColor" font-size="12" text-anchor="middle">
          <text x="75" y="248">30</text>
          <text x="195" y="248">85</text>
          <text x="325" y="248">45</text>
          <text x="405" y="248">35</text>
          <text x="460" y="248">20</text>
          <text x="196" y="72">Ø40 h6</text>
          <text x="325" y="72">chavetero</text>
        </g>
      </svg>
    </div>
  </section>

  <section class="destacados blueprint" aria-label="Proyectos y conocimiento">
    <div class="interior">
      <h2 id="t-destacados">Proyectos recientes</h2>
      <div class="tablero">
        {destacados.map((p, i) => <PostIt proyecto={p} indice={i} />)}
        {Array.from({ length: vacios }, (_, i) => <PostItVacio indice={i} />)}
      </div>
      <a class="ver-todos" href={url('/proyectos/')}>Ver todos los proyectos</a>

      <h2 class="visually-hidden">Conocimiento</h2>
      <div class="saber-grid">
      <div class="estante-solo">
        <a class="libro-grande" href={url('/conocimiento/')} aria-describedby="d-conocimiento">
          <span class="lomo-texto" id="t-conocimiento">Conocimiento</span>
        </a>
        <span class="repisa" aria-hidden="true"></span>
      </div>
      <p class="saber-texto" id="d-conocimiento">
        Metodologías de diseño y fundamentos teóricos, con ecuaciones explicadas paso a paso y calculadoras para
        experimentar. Toma el libro para entrar a la biblioteca.
      </p>
    </div>
    </div>
  </section>


</Base>

<style>
  .hero {
    border-bottom: 1px solid var(--blueprint-linea-fuerte);
  }
  .hero-interior {
    max-width: 76rem;
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 6.5rem) 1rem clamp(3rem, 7vw, 5.5rem);
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero-interior {
      grid-template-columns: 1.05fr 1fr;
    }
  }
  h1 {
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  .lema {
    margin-top: 1.25rem;
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    line-height: 1.55;
    max-width: 38ch;
    color: color-mix(in oklab, white 82%, var(--color-cian));
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .boton {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.15rem;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 160ms var(--ease-out-fuerte),
      background-color 160ms ease;
  }
  .boton:active {
    transform: scale(0.97);
  }
  .boton-primario,
  .boton-primario:visited {
    background: var(--color-amarillo);
    color: var(--color-texto);
  }
  .boton-primario:hover {
    background: color-mix(in oklab, var(--color-amarillo) 85%, white);
  }
  .boton-secundario,
  .boton-secundario:visited {
    color: #fff;
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-cian) 70%, white);
  }
  .boton-secundario:hover {
    background: rgb(255 255 255 / 0.06);
  }

  /* Dibujo técnico que se traza una sola vez al cargar */
  .plano {
    width: 100%;
    max-width: 560px;
    justify-self: center;
    color: color-mix(in oklab, white 88%, var(--color-cian));
  }
  .plano path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: trazar 1.6s var(--ease-out-fuerte) forwards;
  }
  .cota {
    stroke: var(--color-cian);
  }
  .cota path {
    animation-delay: 0.7s;
  }
  .cota .eje {
    stroke-dasharray: 0.03 0.012 0.004 0.012;
    stroke-dashoffset: 0;
    animation: aparecer 0.6s ease 0.5s both;
  }
  .rotulos {
    fill: var(--color-cian);
    font-family: var(--font-mono);
    animation: aparecer 0.6s ease 1.4s both;
  }
  @keyframes trazar {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes aparecer {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .plano path {
      stroke-dashoffset: 0;
      animation: none;
    }
    .cota .eje {
      stroke-dasharray: 0.03 0.012 0.004 0.012;
    }
  }

  .destacados {
    background-color: color-mix(in oklab, var(--color-marino) 92%, black);
  }
  .interior {
    max-width: 76rem;
    margin: 0 auto;
    padding: 3.5rem 1rem 4.5rem;
  }
  .destacados h2 {
    font-size: 1.5rem;
    font-weight: 650;
  }
  .tablero {
    margin-top: 2.5rem;
    display: grid;
    gap: 2.75rem 2.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }

  .ver-todos,
  .ver-todos:visited {
    display: inline-block;
    margin-top: 3rem;
    color: #fff;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-amarillo);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  /* Libro "Conocimiento" de pie sobre el plano */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .saber-grid {
    display: grid;
    gap: 2rem 3.5rem;
    align-items: end;
    margin-top: 4rem;
  }
  @media (min-width: 720px) {
    .saber-grid {
      grid-template-columns: auto 1fr;
    }
  }
  .estante-solo {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: fit-content;
  }
  .libro-grande {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 1.5rem;
    width: 4.75rem;
    height: 19rem;
    background: var(--color-amarillo);
    color: var(--color-texto);
    text-decoration: none;
    border-radius: 4px 4px 1px 1px;
    box-shadow:
      inset 4px 0 0 rgb(255 255 255 / 0.25),
      inset -6px 0 0 rgb(0 0 0 / 0.14),
      0 18px 30px -14px rgb(0 0 0 / 0.7);
    transition: transform 260ms var(--ease-out-fuerte);
  }
  .libro-grande:visited {
    color: var(--color-texto);
  }
  .libro-grande::before,
  .libro-grande::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 7px;
    background: var(--color-marino);
    opacity: 0.85;
  }
  .libro-grande::before {
    top: 1.4rem;
    box-shadow: 0 12px 0 -4px var(--color-marino);
  }
  .libro-grande::after {
    bottom: 1.4rem;
    box-shadow: 0 -12px 0 -4px var(--color-marino);
  }
  .lomo-texto {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 1.55rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .repisa {
    display: block;
    width: 13rem;
    height: 0.8rem;
    background: color-mix(in oklab, var(--color-cian) 55%, var(--color-marino));
    border-top: 2px solid var(--color-cian);
    box-shadow: 0 10px 16px -8px rgb(0 0 0 / 0.6);
  }
  .libro-grande:active {
    transform: translateY(-8px) scale(0.98);
  }
  @media (hover: hover) and (pointer: fine) {
    .libro-grande:hover {
      transform: translateY(-16px);
    }
  }
  .saber-texto {
    max-width: 42ch;
    font-size: 1.15rem;
    line-height: 1.6;
    color: color-mix(in oklab, white 82%, var(--color-cian));
    padding-bottom: 1.5rem;
  }
</style>
